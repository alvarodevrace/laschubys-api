# Gentleman Guardian Angel Configuration
# Provider: opencode — usa la auth del propio opencode (sin API key aparte)
PROVIDER="opencode"

# Revisar todos los archivos staged (override del config global de gentle-ai)
FILE_PATTERNS="*"

# Agente headless de opencode sin tools de escritura (evita corrupción del índice git)
OPENCODE_AGENT="gga-reviewer"
